{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-luma",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.mts",
    "css": "src/styles/globals.css",
    "baseColor": "zinc",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "tabler",
  "rtl": false,
  "menuColor": "default",
  "menuAccent": "subtle",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@audio": "https://audio-ui.xyz/r/{name}.json",
    "@elevenlabs-ui": "https://ui.elevenlabs.io/r/{name}.json",
    "@cult-ui": "https://cult-ui.com/r/{name}.json",
    "@unlumen-ui": "https://ui.unlumen.com/r/{name}.json",
    "@shark": "https://shark.vini.one/r/{name}.json",
    "@uitripled": "https://ui.tripled.work/r/{name}.json",
    "@fab-ui": "https://fab-ui.com/r/{name}.json",
    "@basecn": "https://basecn.dev/r/{name}.json",
    "@waves-cn": "https://waves-cn.vercel.app/r/{name}.json",
    "@ss-components": "https://shadcnstudio.com/r/{style}/{name}.json"
  }
}

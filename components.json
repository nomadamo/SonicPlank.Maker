{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-mira",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/styles/globals.css",
    "baseColor": "gray",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "hugeicons",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@elevenlabs-ui": "https://ui.elevenlabs.io/r/{name}.json",
    "@cult-ui": "https://cult-ui.com/r/{name}.json",
    "@unlumen-ui": "https://ui.unlumen.com/r/{name}.json",
    "@shark": "https://shark.vini.one/r/{name}.json"
  }
}

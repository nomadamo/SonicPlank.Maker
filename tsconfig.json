{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "nodenext",
    "lib": ["dom", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "paths": {
      "@*": [
        "./*"
      ]
    }
  }
}
